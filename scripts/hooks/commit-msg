#!/bin/sh
# Reject AI attribution trailers, generation footers, and non-conventional
# commit messages. Wired by `just setup` via core.hooksPath.
#
# The rules live in scripts/check-commit-messages.sh, which CI's `commits` job
# runs over a pull request's range — so a fork with no hooks installed is now
# caught on the PR instead of at review time.
exec "$(git rev-parse --show-toplevel)/scripts/check-commit-messages.sh" --message "$1"
