#!/bin/sh
# Defense-in-depth: reject pushes containing AI attribution trailers, generation
# footers, AI author emails, or non-conventional subjects. Catches commits that
# bypassed `commit-msg` (--no-verify, imported history, commits made from another
# machine). Wired by `just setup` via core.hooksPath.
#
# The rules live in scripts/check-commit-messages.sh — one copy, shared with the
# commit-msg hook and CI's `commits` job. Until they were extracted this file and
# commit-msg each carried their own patterns and had already drifted.

set -eu

checker="$(git rev-parse --show-toplevel)/scripts/check-commit-messages.sh"
zero='0000000000000000000000000000000000000000'
fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        # A branch the remote does not have yet: everything it would add that no
        # other remote branch already carries. Passed through as rev-list
        # arguments rather than folded into a range, because there is no single
        # commit to anchor one to.
        "$checker" "$local_sha" --not --remotes || fail=1
    else
        "$checker" "$remote_sha..$local_sha" || fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    echo "pre-push blocked. Rewrite the offending commits before pushing."
    exit 1
fi
exit 0
