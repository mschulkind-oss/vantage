# Go
/vantage
*.test
*.out

# Frontend bundle is generated by `just bundle-frontend`; the build fills
# web/dist with real assets (all ignored). Only the .gitkeep sentinel is
# tracked, so //go:embed always has a directory to embed and the build never
# overwrites a tracked file.
/web/dist/*
!/web/dist/.gitkeep

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend build
frontend/dist/

# Generated package build output
packages/vantage-md/dist/

# Built docs output
/dist/

# Environment
.env

# Overmind
.overmind.sock
.overmind.pid
overmind.log

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

/.chrome-state/

# YOLO Jail workspace state
.yolo/
