{
  "name": "vantage-check",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-facing CLI for Vantage: emit the Markdown style guide, and check that a document really renders",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mschulkind-oss/vantage",
    "directory": "packages/vantage-check"
  },
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts'"
  },
  "dependencies": {
    "dompurify": "^3.3.1",
    "github-slugger": "^2.0.0",
    "katex": "^0.18.4",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "remark-gfm": "^4.0.1",
    "remark-lint-no-undefined-references": "^5.0.2",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-preset-lint-recommended": "^7.0.1",
    "smol-toml": "^1.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "eslint": "^10.7.0",
    "globals": "^17.11.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
