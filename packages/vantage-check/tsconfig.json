{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "vantage-md": ["../vantage-md/src/index.ts"],
      "dompurify": ["./src/shims/dompurify.ts"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "scripts", "vitest.config.ts"]
}
